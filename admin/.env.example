MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=duodian
MYSQL_PASSWORD=duodian123

DUODIAN_FRONTEND_PORT=8006
DUODIAN_DATA_DIR=${HOME}/zhanghaoguanjia

MYSQL_BACKUP_INTERVAL_SECONDS=86400
MYSQL_BACKUP_MAX_BACKUPS=30
MYSQL_BACKUP_INIT=1

APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_ROOT=/zhanghaoguanjia/files/
APP_STORAGE_ENDPOINT=
APP_STORAGE_BUCKET=
APP_STORAGE_REGION=
APP_STORAGE_ACCESS_KEY=
APP_STORAGE_SECRET_KEY=
APP_STORAGE_PUBLIC_BASE_URL=
APP_STORAGE_ADDRESSING_STYLE=path

# Required by the clone authorization token signer.
# Generate a PKCS#8 RSA private key and set the Base64-encoded DER value here.
APP_CLONE_AUTH_PUBLIC_KEY_ID=rsa_2026_01
APP_CLONE_AUTH_PRIVATE_KEY=

# Review callout callback. Keep disabled unless the external callout platform is configured.
APP_REVIEW_CALLOUT_CALLBACK_ENABLED=false
APP_REVIEW_CALLOUT_CALLBACK_TOKEN=
APP_REVIEW_CALLOUT_CALLBACK_ACCEPT_QUERY_TOKEN=true
APP_REVIEW_CALLOUT_BILLING_MODE=BILLED_MINUTES
APP_REVIEW_CALLOUT_BILLING_RATE_UNITS_PER_MINUTE=1
APP_REVIEW_CALLOUT_BILLING_MINIMUM_CHARGE_UNITS=1

MYSQL_BACKUP_CRON=0 0 * * *
MYSQL_BACKUP_MAX_BACKUPS=30
MYSQL_BACKUP_INIT=0
