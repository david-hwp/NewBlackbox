<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <include
        android:id="@+id/swipeRepairAction"
        layout="@layout/item_shop_repair_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- 店铺Logo -->
                    <ImageView
                        android:id="@+id/shopLogo"
                        android:layout_width="@dimen/shop_card_logo_size"
                        android:layout_height="@dimen/shop_card_logo_size"
                        android:background="@drawable/bg_platform_logo_circle"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- 中间信息区 -->
                    <LinearLayout
                        android:id="@+id/infoContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/daysContainer"
                        app:layout_constraintStart_toEndOf="@id/shopLogo"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/shopName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/fg"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="新增店铺-[12] 长店铺名称第二行继续显示超出后省略" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/shopId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            tools:text="M123456" />

                        <TextView
                            android:id="@+id/shopRemark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:text="备注: 每天日报发给贺伟平"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvShopAuthorizationLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="2dp"
                            android:clickable="true"
                            android:contentDescription="@string/shop_authorization_login"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="yes"
                            android:minWidth="96dp"
                            android:text="@string/shop_authorization_login"
                            android:textColor="@color/duodian_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 右侧剩余天数 -->
                    <LinearLayout
                        android:id="@+id/daysContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/remainingDaysBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/fg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="15天" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 自动续时三角标 -->
                <FrameLayout
                    android:id="@+id/autoRenewTriangle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:forceDarkAllowed="false"
                        android:src="@drawable/bg_auto_renew_triangle" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />
                </FrameLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/shopFeatureBar"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="@color/surface"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="5dp">

                <LinearLayout
                    android:id="@+id/btnQuickShare"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wechat_action"
                    android:gravity="center"
                    android:minHeight="60dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="2dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="分享"
                        android:src="@drawable/ic_share" />

                    <TextView
                        android:id="@+id/tvQuickShareLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="分享"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeatureBadReviewLocation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeatureBadReviewLocationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/shop_feature_bad_review_location"
                        android:textColor="@color/fg_2"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="44dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="2dp"
                        android:clickable="false"
                        android:enabled="false"
                        android:scaleX="0.72"
                        android:scaleY="0.72" />

                    <TextView
                        android:id="@+id/tvFeatureBadReviewLocationLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvFeatureBadReviewLocationLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeatureBusinessReport"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeatureBusinessReportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/shop_feature_business_report"
                        android:textColor="@color/fg_2"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="44dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="2dp"
                        android:clickable="false"
                        android:enabled="false"
                        android:scaleX="0.72"
                        android:scaleY="0.72" />

                    <TextView
                        android:id="@+id/tvFeatureBusinessReportLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvFeatureBusinessReportLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeatureOutboundPraise"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeatureOutboundPraiseTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/shop_feature_outbound_praise"
                        android:textColor="@color/fg_2"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="44dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="2dp"
                        android:clickable="false"
                        android:enabled="false"
                        android:scaleX="0.72"
                        android:scaleY="0.72" />

                    <TextView
                        android:id="@+id/tvFeatureOutboundPraiseLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvFeatureOutboundPraiseLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeatureReviewAppeal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeatureReviewAppealTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/shop_feature_review_appeal"
                        android:textColor="@color/fg_2"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="44dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="2dp"
                        android:clickable="false"
                        android:enabled="false"
                        android:scaleX="0.72"
                        android:scaleY="0.72" />

                    <TextView
                        android:id="@+id/tvFeatureReviewAppealLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvFeatureReviewAppealLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeaturePrivateTraffic"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFeaturePrivateTrafficTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/shop_feature_private_traffic"
                        android:textColor="@color/fg_2"
                        android:textSize="10sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="44dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="2dp"
                        android:clickable="false"
                        android:enabled="false"
                        android:scaleX="0.72"
                        android:scaleY="0.72" />

                    <TextView
                        android:id="@+id/tvFeaturePrivateTrafficLine1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvFeaturePrivateTrafficLine2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="-"
                        android:textColor="@color/meta"
                        android:textSize="9sp" />

                </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <include
            android:id="@+id/swipeActions"
            layout="@layout/item_shop_swipe_actions"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

    </LinearLayout>

</FrameLayout>
