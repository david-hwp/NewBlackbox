<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp">

    <include
        android:id="@+id/swipeRepairAction"
        layout="@layout/item_shop_repair_action"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <!-- 店铺Logo -->
                    <ImageView
                        android:id="@+id/shopLogo"
                        android:layout_width="@dimen/shop_card_logo_size"
                        android:layout_height="@dimen/shop_card_logo_size"
                        android:background="@drawable/bg_platform_logo_circle"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- 中间信息区 -->
                    <LinearLayout
                        android:id="@+id/infoContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/daysContainer"
                        app:layout_constraintStart_toEndOf="@id/shopLogo"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/shopName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/fg"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="新增店铺-[12] 长店铺名称第二行继续显示超出后省略" />

                            <TextView
                                android:id="@+id/newTag"
                                android:layout_width="wrap_content"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_badge_green"
                                android:gravity="center"
                                android:minWidth="34dp"
                                android:paddingHorizontal="6dp"
                                android:text="new"
                                android:textColor="@color/white"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/shopId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/muted"
                            android:textSize="11sp"
                            tools:text="M123456" />

                    </LinearLayout>

                    <!-- 右侧剩余天数 -->
                    <LinearLayout
                        android:id="@+id/daysContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/remainingDaysBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/fg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="15天" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- 自动续时三角标 -->
                <FrameLayout
                    android:id="@+id/autoRenewTriangle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:forceDarkAllowed="false"
                        android:src="@drawable/bg_auto_renew_triangle" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/white" />
                </FrameLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <include
            android:id="@+id/swipeActions"
            layout="@layout/item_shop_swipe_actions"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

    </LinearLayout>

</FrameLayout>
