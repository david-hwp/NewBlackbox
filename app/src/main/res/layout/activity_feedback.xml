<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duodian_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/duodian_primary"
        android:theme="@style/ToolBarColorStyle"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="问题反馈"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etFeedback"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="@string/feedback_hint"
                android:padding="12dp"
                android:textColor="@color/duodian_text_primary"
                android:textColorHint="@color/duodian_text_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvImageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="未上传图片"
                android:textColor="@color/duodian_text_secondary"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:id="@+id/imagePreviewScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/imagePreviewList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddImages"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:text="选择图片"
                android:textColor="@color/duodian_primary"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbUploadLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/duodian_primary"
                android:checked="true"
                android:text="同时上传最近1小时的 INFO 级别运行日志"
                android:textColor="@color/duodian_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/feedback_submit"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
