<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duodian_background"
    android:orientation="vertical"
    tools:context=".view.logs.LogsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/duodian_primary"
        android:theme="@style/ToolBarColorStyle"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/logs_title"
        app:titleTextColor="@color/white" />

    <!-- 筛选标签栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/duodian_surface"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_all"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipOut"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_out"
                android:textColor="@color/duodian_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipIn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_in"
                android:textColor="@color/duodian_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipConsume"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_consume"
                android:textColor="@color/duodian_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chipPhoneConsume"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/tab_phone_consume"
                android:textColor="@color/duodian_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />
</LinearLayout>
